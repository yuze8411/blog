# 和风天气 API Key（控制台 → 项目管理 → 凭据）
QWEATHER_KEY=

# 和风天气 API Host（控制台 → 设置），形如 abcxyz.qweatherapi.com，不要带 https://
QWEATHER_API_HOST=

# GitHub 个人访问令牌（Classic PAT，勾选 read:user 即可）
# 留在服务端使用，不要加 VITE_ 前缀；留空时热力图会提示加载失败
GITHUB_PAT=

# DeepSeek（后台 AI 写作）
# 不加 VITE_ 前缀，只在服务端 /api/deepseek 里使用，不会打包进前端
DEEPSEEK_API_KEY=
# 模型名以 DeepSeek 控制台为准（用户要求使用 flash 模型）
DEEPSEEK_MODEL=deepseek-flash
# 接口地址，一般不用改
DEEPSEEK_BASE_URL=https://api.deepseek.com
